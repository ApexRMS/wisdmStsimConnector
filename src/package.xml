<?xml version="1.0" encoding="utf-8"?>
<package name="wisdmStsimConnector" displayName="WISDM to ST-Sim Connector" description="Connector package between WISDM and ST-Sim" version="1.3.0" minSyncroSimVersion="3.1.27">

<builtFor package="wisdm" version="2.6.1"/>
<builtFor package="stsim" version="4.5.4"/>

<dataSheet name="Options" displayName="Options" isSingleRow="True">
	<column name="Model" displayName="Target model" dataType="Integer" validationType="List" formula1="0:Boosted Regression Trees|1:Generalized Linear Model|2:Maxent|3:Random Forest|4:Ensemble|5:Generalized Linear Model - LASSO|6:Generalized Additive Model"/>
	<column name="BuildFrom" displayName="Build transition spatial multipliers from" dataType="Integer" validationType="List" formula1="0:Probability map|1:Binary map"/>
	<column name="BuildFor" displayName="Build transition spatial multipliers for" dataType="Integer" validationType="Datasheet" formula1="stsim_TransitionType"/>
	<column name="Timestep" displayName="Timestep" dataType="Integer" isOptional="True"/>
	<column name="MultiplierMinimum" displayName="Multiplier at 0% suitability" dataType="Double" defaultValue="0" validationType="Decimal" validationCondition="GreaterEqual" formula1="0"/>
	<column name="MultiplierMaximum" displayName="Multiplier at 100% suitability" dataType="Double" defaultValue="1" validationType="Decimal" validationCondition="GreaterEqual" formula1="0"/>
</dataSheet>

<!--Prepare Transition Spatial Multipliers-->
<transformer
	name="WisdmToStsim"
	displayName="Prepare WISDM output for ST-Sim"
	programName="Rscript"
	programArguments="prepare-transition-spatial-multipliers.R"
	condaEnv="wisdm-r-conda.yml"
	condaEnvVersion="7">
	<!--configurationSheet="stsim_RunControl"
	isStochasticTime="True"
	TransformerSpecificOutput="False"-->
		<dataSheet name="Options" type="Input"/>
		<dataSheet name="wisdm_OutputSpatial" type="Input"/>
		<dataSheet name="wisdm_OutputEnsemble" type="Input"/>
		<dataSheet name="stsim_InitialConditionsSpatial" type="Input"/>
		<dataSheet name="stsim_InitialConditionsSpatialProperties" type="Input"/>
		<dataSheet name="stsim_TransitionSpatialMultiplier" type="Output"/>
</transformer>

<!--Scenario Datafeeds Layout-->
<layout type="Scenario">
	<item name="Options"/>
</layout> 

<updateProvider className="SyncroSim.Core.XMLUpdateProvider" classAssembly="SyncroSim.Core"/>

</package>
